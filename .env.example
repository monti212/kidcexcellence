# Runtime persistence
#
# Cloudflare D1 is the production store. lib/platform-store.ts picks a driver in
# this order: D1 if configured, then Supabase, then the local JSON file.
# Apply d1/migrations/*.sql to the database before first use.

# --- Cloudflare D1: production transport -------------------------------------
#
# A Worker you deploy (see d1/proxy-worker/) that owns the real D1 binding and
# runs a whole batch in one request. This is the only transport that survives
# production traffic; see d1/README.md for why.
#
# D1_PROXY_TOKEN executes arbitrary SQL against the platform database. Treat it
# like a root password: never prefix it with NEXT_PUBLIC_.
D1_PROXY_URL=
D1_PROXY_TOKEN=

# --- Cloudflare D1: development transport ------------------------------------
#
# Cloudflare's REST API. No extra deployment, so it is convenient for local
# work, migrations, and scripts. NOT for production: Cloudflare rate limits it
# at 1200 requests per five minutes across the whole account, and each
# readStore() costs 14 of them.
#
# Scope the token to D1 Edit on this database only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# --- Supabase Postgres: previous store, still selectable ---------------------
#
# SUPABASE_SECRET_KEY is a server-only key that bypasses row level security.
# Never expose it to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional. Unused today — kept for a future browser client and for verifying
# Supabase Auth JWTs if auth moves off the first-party session cookie.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=

# Forces a persistence driver: "d1", "supabase", or "json". Leave unset to pick
# automatically from the credentials above. The integration suite sets "json" so
# tests never write to a live database.
PLATFORM_STORE_DRIVER=

# Local JSON fallback store. Used only when no database is configured. In that
# mode, point this at a writable mounted volume in production.
PLATFORM_STORE_PATH=./data/platform-store.json

# Provider document and gallery uploads still use the local filesystem.
PLATFORM_UPLOADS_DIR=./data/uploads

# Optional sample listings for local demonstrations. Never enable this in a
# production environment; production should expose only provider-owned listings.
ENABLE_DEMO_PROVIDERS=true

# Public app URL for metadata, links, and deployment checks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated emails that may create or use admin accounts.
ADMIN_EMAILS=admin@example.com

# --- Stripe billing ----------------------------------------------------------
#
# Enables subscriptions, verification fees, vetting packages, and the Billing
# Portal. Without it, checkout routes return 503 and the verification fee falls
# back to a local "mark as paid" recorder that is blocked in production.
#
# Use a RESTRICTED key (rk_), not a secret key (sk_). A restricted key carries
# only the permissions you grant it, so a leak does far less damage. This
# integration needs write access to Customers, Checkout Sessions, Billing
# Portal, Products, and Prices, and read access to Subscriptions and Invoices.
# Store it in your host's secrets vault rather than a committed file.
STRIPE_SECRET_KEY=

# Signing secret for /api/stripe/webhook, from `stripe listen` or the webhook
# endpoint's dashboard page. The webhook is the ONLY writer of paid state, so
# without this secret no payment is ever recorded.
STRIPE_WEBHOOK_SECRET=

# Stripe Price ids, created by `node scripts/stripe-setup.mjs`.
#
# Set these before taking live payments. Without them, checkout falls back to
# inline price_data, which makes Stripe create a NEW Product on every single
# checkout — filling the catalogue with duplicates and breaking Dashboard
# revenue reporting.
STRIPE_PRICE_PARENT=
STRIPE_PRICE_CARE_WORKER=
STRIPE_PRICE_PROVIDER=
STRIPE_PRICE_VERIFICATION_CARE_WORKER=
STRIPE_PRICE_VERIFICATION_ORGANISATION=
STRIPE_PRICE_VETTING_STANDARD=
STRIPE_PRICE_VETTING_VIP=
