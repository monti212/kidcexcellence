# Runtime persistence
#
# The current platform foundation uses a server-side JSON store for local
# development and early demos. Netlify production and deploy previews use
# Netlify Blobs by default through PLATFORM_STORAGE_DRIVER=netlify-blobs in
# netlify.toml. For another production host, use a durable mounted volume with
# PLATFORM_STORAGE_DRIVER=filesystem, or replace lib/platform-store.ts with a
# database adapter and keep the API route contracts stable.
PLATFORM_STORAGE_DRIVER=filesystem
PLATFORM_STORE_PATH=./data/platform-store.json
PLATFORM_UPLOADS_DIR=./data/uploads

# Optional sample listings for local demonstrations. Keep this disabled for
# real platform data so only provider-owned listings appear.
ENABLE_DEMO_PROVIDERS=false

# Public app URL for metadata, links, and deployment checks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated emails that may create or use admin accounts.
# The platform also has built-in access for monti@uhuruai.co,
# gaone@uhuruai.co, and katlotarniah@gmail.com.
ADMIN_EMAILS=monti@uhuruai.co,gaone@uhuruai.co,katlotarniah@gmail.com

# Stripe hosted payment links for verification and vetting packages.
# Use Stripe Payment Links or Checkout links. When these are configured, the
# provider payment button redirects to Stripe instead of using the local demo
# payment recorder.
STRIPE_VERIFICATION_PAYMENT_LINK=
STRIPE_STANDARD_VETTING_PAYMENT_LINK=
STRIPE_VIP_VETTING_PAYMENT_LINK=
