{
  "name": "kidcellence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:integration": "node --test scripts/integration-smoke.mjs",
    "test": "npm run test:integration && npm run test:store && npm run test:postgres",
    "test:store": "node --test --test-concurrency=1 scripts/store-engine.test.mjs scripts/store-concurrency.test.mjs",
    "test:postgres": "node --import ./scripts/test-support/register-alias.mjs --test --test-concurrency=1 scripts/postgres-store.test.mjs scripts/db-migration.test.mjs && next build && node --test --test-concurrency=1 scripts/postgres-e2e.test.mjs",
    "db:migrate": "node scripts/db-migrate.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@netlify/blobs": "^10.7.13",
    "@netlify/database": "2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  }
}
